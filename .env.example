# ── Slack Bot ──────────────────────────────────────────────
SLACK_SIGNING_SECRET=your_signing_secret_here
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# ── AI / Inference ─────────────────────────────────────────
# Primary: Anthropic API (used by Slack bot + inference fallback)
CLAUDE_API_KEY=sk-ant-your-api-key-here

# vLLM backend (set this when you have a GPU running vLLM)
# If not set, inference API falls back to Anthropic for dev/testing
VLLM_URL=http://your-gpu-server:8000

# ── Supabase (inference API database) ──────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth (inference API JWT) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here

# ── Stripe (billing) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Server ─────────────────────────────────────────────────
PORT=3000            # Slack bot port
INFERENCE_PORT=3001  # Inference API port
NODE_ENV=production
APP_URL=https://your-domain.com

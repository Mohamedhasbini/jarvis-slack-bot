# ── Slack Bot ──────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=your_signing_secret_here
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# ── AI / Inference ─────────────────────────────────────────────────────────
# Primary: Anthropic (used by Slack bot + inference API fallback when no VLLM)
CLAUDE_API_KEY=sk-ant-your-api-key-here

# vLLM backend URL (point at your GPU server running vLLM)
# If unset, inference API proxies through Anthropic instead
VLLM_URL=http://your-gpu-server:8000

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-64-chars-minimum

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Leave unset during dev — emails print to console instead
# For production: use SendGrid, Postmark, or Gmail SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
EMAIL_FROM="Jarvis Inference <noreply@yourdomain.com>"

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Test keys:  sk_test_...  /  whsec_test_...

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of the inference API server (used in verification email links)
APP_URL=https://api.yourdomain.com

PORT=3000           # Slack bot port
INFERENCE_PORT=3001 # Inference API port
NODE_ENV=production
